{
  "name": "mogi-worker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run type-check && npm test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:bootstrap:local": "wrangler d1 execute DB --local --file=./schema.sql && wrangler d1 migrations apply DB --local",
    "simulate-call": "node scripts/simulate-call.mjs",
    "diagnose-voice": "node scripts/diagnose-voice.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "drizzle-orm": "^0.44.0",
    "hono": "^4.7.0",
    "jose": "^5.10.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250401.0",
    "drizzle-kit": "^0.30.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.7",
    "wrangler": "^4.0.0",
    "ws": "^8.21.3"
  },
  "engines": {
    "node": ">=20"
  }
}
