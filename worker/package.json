{
  "name": "mogi-worker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run type-check && npm test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:bootstrap:local": "wrangler d1 execute DB --local --file=./schema.sql && wrangler d1 migrations apply DB --local",
    "simulate-call": "node scripts/simulate-call.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.7.0",
    "jose": "^6.2.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261031.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.0.0",
    "ws": "^8.21.3"
  },
  "engines": {
    "node": ">=20"
  }
}
