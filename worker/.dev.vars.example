# Local secrets for `wrangler dev`. Copy to .dev.vars (gitignored):
#   cp .dev.vars.example .dev.vars
# Production values are set with `wrangler secret put <NAME>` — see the
# secrets list in wrangler.toml.

# Relaxes fail-closed checks for local work (unsigned Twilio/WhatsApp
# webhooks, media streams without a signed token, dev hash salt).
NODE_ENV=development

TOKEN_SECRET=dev-secret-minimum-32-characters-long
CUSTOMER_HASH_SALT=dev-hash-salt
ADMIN_SECRET=dev-admin-key
ANTHROPIC_API_KEY=sk-ant-...

# Voice
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
# Hindi / Hinglish via Sarvam AI (dashboard.sarvam.ai). Only businesses whose
# voice settings pick Sarvam use it; their calls are refused without it.
SARVAM_API_KEY=

# Optional. Without RESEND_API_KEY, local sign-in returns the one-time code
# to the UI instead of emailing it (development only).
RESEND_API_KEY=
EMAIL_FROM=Mogi <mogi@yourstore.example.com>
# Optional: owners' "Request a phone number" is emailed here (needs RESEND_API_KEY)
ADMIN_NOTIFY_EMAIL=
TWILIO_AUTH_TOKEN=
TWILIO_WEBHOOK_URL=

# Indian numbers (optional). Exotel: shared secret every /exotel/* URL in
# the call flow carries (Basic auth or ?key=); Plivo: signature verification.
EXOTEL_WEBHOOK_SECRET=
EXOTEL_DEFAULT_BUSINESS_TYPE=
PLIVO_AUTH_TOKEN=
PLIVO_WEBHOOK_URL=

# Calendar integration (optional). Google OAuth client redirect URI for
# local dev: http://localhost:8787/oauth/google/callback
CALENDAR_TOKEN_KEY=dev-calendar-token-key
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Billing (optional). Use Razorpay *test mode* keys locally. With no
# RAZORPAY_WEBHOOK_SECRET, development accepts unsigned webhooks (curl).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
