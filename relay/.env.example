# Copy to .env for local testing (never commit .env)

# Your deployed Cloudflare Workers URL
WORKERS_URL=https://your-worker.workers.dev

# ── STT ───────────────────────────────────────────────────────────────────────
# Select engine: deepgram (default) | elevenlabs
STT_ENGINE=deepgram

# ElevenLabs Scribe realtime — https://elevenlabs.io
ELEVENLABS_SPEECH_API_KEY=

# Deepgram — https://console.deepgram.com
# Free tier: $200 credit (~45,000 minutes)
DEEPGRAM_API_KEY=

# ── TTS ───────────────────────────────────────────────────────────────────────
# Cartesia — https://cartesia.ai
CARTESIA_API_KEY=

# Optional: override voice ID from https://play.cartesia.ai
# CARTESIA_VOICE_ID=25d2c432-139c-4035-bfd6-9baaabcdd006

# Optional: override Cartesia model
# CARTESIA_MODEL_ID=sonic-3.5

# ── Twilio ────────────────────────────────────────────────────────────────────
# Set automatically by Fly to your app hostname (e.g. avery-relay.fly.dev).
# Only needed for local testing with ngrok:
# RELAY_HOST=xxxx.ngrok.io
