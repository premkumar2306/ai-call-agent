# Copy to .env for local testing (never commit .env)

# Your deployed Cloudflare Workers URL
WORKERS_URL=https://your-worker.workers.dev

# Deepgram — sign up free at https://console.deepgram.com
# Free tier: $200 credit (~45,000 minutes)
DEEPGRAM_API_KEY=

# Cartesia — sign up at https://cartesia.ai
# Free trial: $5 credit
CARTESIA_API_KEY=

# Optional: override voice ID from https://play.cartesia.ai
# CARTESIA_VOICE_ID=a0e99841-438c-4a64-b679-ae501e7d6091

# TTS engine: cartesia (default, streaming) | polly (AWS, cheaper, non-streaming)
# TTS_ENGINE=polly

# Required only when TTS_ENGINE=polly — AWS credentials
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# Set automatically by Fly to your app hostname, e.g. avery-relay.fly.dev
# Only needed for local testing with ngrok:
# RELAY_HOST=xxxx.ngrok.io
